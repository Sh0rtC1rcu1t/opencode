diff --git a/dist/user-components/html-to-hast.js b/dist/user-components/html-to-hast.js
new file mode 100644
--- /dev/null
+++ b/dist/user-components/html-to-hast.js
@@ -0,0 +1,10 @@
+import { fromHtml } from "hast-util-from-html";
+
+// Cloudflare Workers cannot load Satteri's native Node binding. Keep the
+// runtime component transforms on the portable HTML parser used by remark.
+export function htmlToHast(html, options) {
+  if (options?.space !== "svg") return fromHtml(html, options);
+  const tree = fromHtml(`<svg>${html}</svg>`, { fragment: true });
+  const svg = tree.children.find((node) => node.type === "element" && node.tagName === "svg");
+  return { type: "root", children: svg?.children ?? [] };
+}
